  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one main action on a screen.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Start focusing</button>",
      "css": ".ds-btn{padding:.65rem 1.1rem;border:1px solid transparent;border-radius:8px;font:inherit;font-weight:600;cursor:pointer;transition:background-color .15s}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn-primary{background:var(--accent);color:var(--accent-contrast)}.ds-btn-primary:hover{background:var(--accent-hover)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Alternative actions; hairline outline.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Pause</button>",
      "css": ".ds-btn{padding:.65rem 1.1rem;border:1px solid transparent;border-radius:8px;font:inherit;font-weight:600;cursor:pointer;transition:background-color .15s}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn-secondary{background:transparent;border-color:var(--border);color:var(--text)}.ds-btn-secondary:hover{background:var(--surface-muted)}"
    },
    {
      "name": "Small Pill Button",
      "kind": "button",
      "refersTo": "button-small",
      "description": "Buttons inside panels.",
      "html": "<button class=\"ds-btn ds-btn-secondary ds-btn-small\">Add site</button>",
      "css": ".ds-btn{padding:.65rem 1.1rem;border:1px solid transparent;border-radius:8px;font:inherit;font-weight:600;cursor:pointer;transition:background-color .15s}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn-secondary{background:transparent;border-color:var(--border);color:var(--text)}.ds-btn-secondary:hover{background:var(--surface-muted)}.ds-btn-small{padding:.4rem .9rem;border-radius:999px;font-size:.875rem}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Quiet secondary or discouraged actions.",
      "html": "<button class=\"ds-btn-link\">Override blocking</button>",
      "css": ".ds-btn-link{padding:0;border:0;background:transparent;color:var(--text-muted);font:inherit;font-size:.85rem;text-decoration:underline;text-underline-offset:2px;cursor:pointer}.ds-btn-link:hover{color:var(--text)}.ds-btn-link:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above, optional info tip beside it.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-task\">Task</label><input id=\"ds-task\" class=\"ds-input\" value=\"Read chapter 4\"></div>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.3rem}.ds-label{font-size:.9rem;font-weight:600;color:var(--text)}.ds-input{width:100%;padding:.6rem .75rem;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);font:inherit}.ds-input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Header Navigation",
      "kind": "nav",
      "description": "Text links; current page at full text weight 600.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-brand\">FocusQuest</span><a class=\"ds-current\" href=\"#\">Focus</a><a href=\"#\">Streaks</a><a href=\"#\">Blocking</a><a href=\"#\">Settings</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:1rem;padding:.75rem 1.5rem;border-bottom:1px solid var(--border);background:var(--surface)}.ds-brand{font-family:'Young Serif',Georgia,serif;font-synthesis:none;margin-right:.5rem;color:var(--text)}.ds-nav a{color:var(--text-muted);text-decoration:none}.ds-nav a:hover{color:var(--text)}.ds-nav a.ds-current{color:var(--text);font-weight:600}"
    },
    {
      "name": "Status Pill",
      "kind": "chip",
      "refersTo": "status-pill",
      "description": "Session status; notice tone while blocking is active.",
      "html": "<span class=\"ds-pill\">Blocking off</span> <span class=\"ds-pill ds-pill-active\">Blocking on</span>",
      "css": ".ds-pill{display:inline-block;padding:.15rem .6rem;border-radius:999px;background:var(--surface-muted);color:var(--text);font-size:.85rem;font-weight:600}.ds-pill-active{background:var(--notice-bg);color:var(--notice)}"
    },
    {
      "name": "Collapsible Section",
      "kind": "custom",
      "description": "One line per item: title, muted summary, chevron; hairline below.",
      "html": "<div class=\"ds-section\"><button class=\"ds-section-row\" aria-expanded=\"false\"><span class=\"ds-section-title\">Profile</span><span class=\"ds-section-summary\">Douglas · Europe/Berlin</span><svg class=\"ds-chev\" viewBox=\"0 0 16 16\" width=\"16\" height=\"16\"><path d=\"M4 6l4 4 4-4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div>",
      "css": ".ds-section{border-bottom:1px solid var(--border)}.ds-section-row{display:grid;grid-template-columns:minmax(0,1fr) auto 1rem;align-items:center;gap:1rem;width:100%;padding:1rem .25rem;border:0;background:none;color:var(--text);font:inherit;text-align:left;cursor:pointer}.ds-section-row:hover .ds-section-title{text-decoration:underline;text-underline-offset:3px}.ds-section-row:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-section-title{font-size:1.05rem;font-weight:600}.ds-section-summary{color:var(--text-muted);font-size:.9rem}.ds-chev{color:var(--text-muted);transition:transform .15s}.ds-section-row[aria-expanded=true] .ds-chev{transform:rotate(180deg)}"
    },
    {
      "name": "Progress Bar",
      "kind": "custom",
      "refersTo": "progress-bar",
      "description": "Pill track with label that flips to contrast colour under the fill.",
      "html": "<div class=\"ds-bar\"><div class=\"ds-bar-fill\" style=\"width:60%\"></div><span class=\"ds-bar-text\"><span>Today</span><span>18 / 30 min</span></span><span class=\"ds-bar-text ds-bar-on\" style=\"clip-path:inset(0 40% 0 0)\"><span>Today</span><span>18 / 30 min</span></span></div>",
      "css": ".ds-bar{position:relative;height:1.75rem;overflow:hidden;border-radius:999px;background:var(--surface-muted)}.ds-bar-fill{height:100%;border-radius:999px;background:var(--accent);transition:width .3s}.ds-bar-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:space-between;padding:0 .85rem;color:var(--text);font-size:.85rem;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-bar-on{background:var(--accent);color:var(--accent-contrast)}"
    },
    {
      "name": "Info Tip",
      "kind": "custom",
      "description": "Circular 'i' that reveals an explanation on hover or focus.",
      "html": "<span class=\"ds-info\"><button class=\"ds-info-btn\" aria-label=\"About streak freezes\">i</button><span class=\"ds-info-tip\">A freeze keeps your streak alive for one missed day.</span></span>",
      "css": ".ds-info{position:relative;display:inline-flex;margin-top:4rem}.ds-info-btn{display:inline-flex;align-items:center;justify-content:center;width:1.15rem;height:1.15rem;padding:0;border:1px solid var(--text-muted);border-radius:50%;background:transparent;color:var(--text-muted);font:.7rem/1 'Young Serif',Georgia,serif;font-synthesis:none;cursor:help}.ds-info-btn:hover{border-color:var(--text);color:var(--text)}.ds-info-tip{position:absolute;bottom:calc(100% + .5rem);left:50%;width:max-content;max-width:18rem;padding:.6rem .75rem;border:1px solid var(--border);border-radius:8px;background:var(--surface);box-shadow:0 4px 16px rgb(0 0 0 / .12);color:var(--text);font-size:.85rem;line-height:1.4;transform:translateX(-50%);opacity:0;visibility:hidden;transition:opacity .12s}.ds-info:hover .ds-info-tip,.ds-info-btn:focus-visible+.ds-info-tip{opacity:1;visibility:visible}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Mallard",
    "overview": "FocusQuest borrows its colours from a mallard. By day it is the hen: buff paper, mottled browns, a dark eye-stripe for text. At dusk it is the drake: green-black water and grey body, lit by the iridescent head green. The duck stays calm on the surface and works hard underneath, and so does the interface. The page is quiet and warm, and the green appears only where the student acts or where progress is measured.\n\nThe mood is calm, warm and purposeful. Density is low: one narrow column (44rem at most) and generous vertical rhythm. Each page shows what the student needs right now, and detail sits one click away behind an info tip or a collapsed row. Progression (XP, gems, streaks) is visible but never loud. It shows up as big serif numbers and filled bars, not as celebrations.\n\nThis is not a generic SaaS dashboard (no stat-card grids, gradients or purple-blue tech palette). It is not a sterile productivity tool either (no cold grey-on-white blankness). Warmth comes from the buff ground and the serif, and calm comes from removing frames.",
    "keyCharacteristics": [
      "Warm buff ground in light mode, green-tinted near-black at dusk; both modes are first-class.",
      "No cards. Content sits on the page, divided by hairlines.",
      "Young Serif for titles and the figures the eye should land on; Atkinson Hyperlegible for everything else.",
      "One accent, drake green, reserved for primary actions and measured progress.",
      "Explanations hide behind an \"i\"; secondary actions are quiet underlined links.",
      "Pills for small controls and status; gently rounded rectangles for fields and main buttons."
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "section": "colors",
        "body": "Drake green means \"act here\" or \"progress made\". Never use it decoratively, for headings or for success messages; success has its own reed green."
      },
      {
        "name": "The Two Ducks Rule",
        "section": "colors",
        "body": "Every colour is a CSS custom property with a light value and a dark value (`frontend/src/style.css`). Never hard-code a hex in a component, and check every new screen in both modes."
      },
      {
        "name": "The Single Weight Serif Rule",
        "section": "typography",
        "body": "Young Serif has one weight. Every display element sets `font-synthesis: none`, so the browser never fakes a bold; hierarchy in the serif comes from size alone."
      },
      {
        "name": "The Honest Digits Rule",
        "section": "typography",
        "body": "The countdown stays in Atkinson with tabular figures, because the serif's digits are not of equal width and a ticking clock would jitter. Any figure that changes every second follows the same rule."
      },
      {
        "name": "The No-Card Rule",
        "section": "elevation",
        "body": "Content is never boxed in a bordered, rounded panel. Separate groups with a hairline (`border-bottom: 1px solid var(--border)`) and space. The sign-in/setup column is the one surviving framed surface, and the legacy `.card` class is unused; do not revive it."
      }
    ],
    "dos": [
      "Do take every colour from the CSS custom properties in `frontend/src/style.css`, and check new screens in light and dark mode.",
      "Do separate content with 1px hairlines and space rather than frames.",
      "Do put explanations behind an InfoTip; keep visible only short text or what the student must act on.",
      "Do make secondary or discouraged actions link-buttons, and use `size=\"small\"` pill buttons inside panels.",
      "Do collapse long lists and settings to one line per item that opens in place.",
      "Do say a consequence the student commits to (blocking that outlasts the session) in plain text where they commit, not in a tooltip.",
      "Do keep the page from scrolling sideways at 390px; check `scrollWidth` at phone width.",
      "Do state outcomes the app can work out (\"That reaches today's target, so websites unblock now\") instead of if/otherwise copy.",
      "Do keep the theme toggle neutral when on; green is not a decoration for switches.",
      "Do set big numbers in Young Serif with `font-synthesis: none`, and keep the timer in Atkinson with tabular figures.",
      "Do keep the page to a single column of at most 44rem."
    ],
    "donts": [
      "Don't wrap content in bordered, rounded cards, or revive the unused `.card` class.",
      "Don't use drake green for decoration, headings or success; success is reed green.",
      "Don't build a generic SaaS dashboard: no stat-card grids, gradients or purple-blue tech palette.",
      "Don't let it turn sterile: no cold grey-on-white, keep the buff ground and the serif.",
      "Don't add shadows beyond the tooltip and the toggle thumb; depth is tonal.",
      "Don't bold Young Serif or use it for the timer.",
      "Don't show detail a general student doesn't need (per-category rules, pairing or calibration dates)."
    ]
  }
}