{
  "name": "focusquest-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:firefox": "tsc --noEmit && node scripts/build.mjs --firefox",
    "build:safari": "tsc --noEmit && node scripts/build.mjs --safari && scripts/build-safari.sh",
    "watch": "node scripts/build.mjs --watch",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "package:firefox": "web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --overwrite-dest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0"
  }
}
